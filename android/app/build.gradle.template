apply plugin: "com.android.application"
apply plugin: "kotlin-android"
apply plugin: "dev.flutter.flutter-gradle-plugin"
// Add this after you've added the google-services plugin to the
// project-level build.gradle.
apply plugin: "com.google.gms.google-services"

android {
    namespace = "com.shipnow.app"
    compileSdk = 34
    ndkVersion = flutter.ndkVersion

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
    kotlinOptions {
        jvmTarget = JavaVersion.VERSION_17
    }

    defaultConfig {
        applicationId = "com.shipnow.app"
        minSdk = 24            // FCM needs at least 23, MapLibre needs 24
        targetSdk = 34
        versionCode = flutter.versionCode
        versionName = flutter.versionName
    }

    buildTypes {
        release {
            // Add your own signing config here for Play Store release.
            signingConfig = signingConfigs.debug
            minifyEnabled = false
        }
    }
}

dependencies {
    implementation("com.google.firebase:firebase-messaging:24.0.0")
    implementation(platform("com.google.firebase:firebase-bom:33.1.0"))
}
