{
  "name": "AirPak Express",
  "short_name": "AirPak",
  "description": "Global logistics platform with real-time tracking, Airpak Coin settlement, and 14 partner carriers across 220 destinations.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#DC2626",
  "categories": ["business", "productivity", "shopping", "travel"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "edge_side_panel": { "preferred_width": 480 },
  "launch_handler": {
    "client_mode": "auto"
  },
  "handle_links": "preferred",
  "protocol_handlers": [
    {
      "protocol": "web+airpak",
      "url": "/open?uri=%s"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link"
    }
  },
  "icons": [
    {
      "src": "icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "favicon.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/dashboard.png",
      "sizes": "1290x2796",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Track shipments in real time"
    },
    {
      "src": "screenshots/livemap.png",
      "sizes": "1290x2796",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Live world map"
    }
  ],
  "shortcuts": [
    {
      "name": "Track parcel",
      "short_name": "Track",
      "url": "/#/portal/track",
      "icons": [
        { "src": "icons/Icon-192.png", "sizes": "192x192" }
      ]
    },
    {
      "name": "Create shipment",
      "short_name": "Create",
      "url": "/#/portal/shipments/new",
      "icons": [
        { "src": "icons/Icon-192.png", "sizes": "192x192" }
      ]
    },
    {
      "name": "Pay invoice",
      "short_name": "Pay",
      "url": "/#/portal/payments",
      "icons": [
        { "src": "icons/Icon-192.png", "sizes": "192x192" }
      ]
    }
  ],
  "permissions": [
    "geolocation",
    "notifications",
    "camera",
    "microphone",
    "payment-handler"
  ],
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "application/pdf": [".pdf"],
        "image/*": [".jpg", ".jpeg", ".png", ".webp"]
      }
    }
  ]
}
