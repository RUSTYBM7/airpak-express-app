<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <!-- Web Clip payload: add AirPak PWA to home screen -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.airpak.express.webclip.customer</string>
            <key>PayloadUUID</key>
            <string>11AABBCC-DDEE-FF11-2233-445566778899</string>
            <key>PayloadDisplayName</key>
            <string>AirPak Express</string>
            <key>PayloadDescription</key>
            <string>Adds AirPak Express to your home screen</string>
            <key>Label</key>
            <string>AirPak Express</string>
            <key>URL</key>
            <string>https://web-rust-ten-91.vercel.app/</string>
            <key>IsRemovable</key>
            <true/>
        </dict>
        <!-- Restrictions payload: customer-friendly, no restrictions -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.restrictions</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.airpak.express.restrictions.customer</string>
            <key>PayloadUUID</key>
            <string>22AABBCC-DDEE-FF11-2233-445566778899</string>
            <key>PayloadDisplayName</key>
            <string>AirPak — Customer</string>
            <key>PayloadDescription</key>
            <string>Light-touch policies for AirPak customers</string>
            <key>allowCamera</key>
            <true/>
            <key>allowScreenShot</key>
            <true/>
            <key>allowUIAppInstallation</key>
            <true/>
            <key>allowInAppPurchases</key>
            <true/>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>AirPak Express — Customer</string>
    <key>PayloadDescription</key>
    <string>Adds AirPak Express to your home screen as a full-screen app.</string>
    <key>PayloadIdentifier</key>
    <string>com.airpak.express.customer.profile</string>
    <key>PayloadOrganization</key>
    <string>AirPak Express Pte Ltd</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>33AABBCC-DDEE-FF11-2233-445566778899</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadScope</key>
    <string>System</string>
    <key>ConsentText</key>
    <dict>
        <key>default</key>
        <string>By installing this profile, AirPak Express will be added to your home screen as a full-screen app for faster access to parcel tracking and customer support.</string>
    </dict>
</dict>
</plist>
