<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <!-- Web Clip payload: adds the AirPak PWA to the home screen as a full-screen app -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.airpak.express.webclip.staff</string>
            <key>PayloadUUID</key>
            <string>A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D</string>
            <key>PayloadDisplayName</key>
            <string>AirPak Express</string>
            <key>PayloadDescription</key>
            <string>Install AirPak Express as a full-screen app</string>
            <key>Label</key>
            <string>AirPak Express</string>
            <key>URL</key>
            <string>https://web-rust-ten-91.vercel.app/</string>
            <key>Icon</key>
            <data></data>
        </dict>
        <!-- Restrictions payload: enforce AirPak security policies -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.restrictions</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.airpak.express.restrictions.staff</string>
            <key>PayloadUUID</key>
            <string>B2C3D4E5-F6A7-4B8C-9D0E-1F2A3B4C5D6E</string>
            <key>PayloadDisplayName</key>
            <string>AirPak Restrictions</string>
            <key>PayloadDescription</key>
            <string>Enforces AirPak device security policies</string>
            <key>allowAirPlayOutgoingRequests</key>
            <true/>
            <key>allowAirDrop</key>
            <true/>
            <key>allowAssistant</key>
            <true/>
            <key>allowAutomaticAppDownloads</key>
            <true/>
            <key>allowBookstore</key>
            <false/>
            <key>allowCamera</key>
            <true/>
            <key>allowCloudBackup</key>
            <true/>
            <key>allowCloudDocumentSync</key>
            <true/>
            <key>allowCloudPhotoLibrary</key>
            <true/>
            <key>allowDiagnosticSubmission</key>
            <true/>
            <key>allowExplicitContent</key>
            <false/>
            <key>allowFindMyDevice</key>
            <true/>
            <key>allowFindMyFriends</key>
            <true/>
            <key>allowGameCenter</key>
            <true/>
            <key>allowGlobalBackgroundFetchWhenRoaming</key>
            <true/>
            <key>allowInAppPurchases</key>
            <false/>
            <key>allowLockScreenControlCenter</key>
            <true/>
            <key>allowLockScreenNotifications</key>
            <true/>
            <key>allowLockScreenTodayView</key>
            <true/>
            <key>allowMailAccountCreation</key>
            <true/>
            <key>allowMultiplayerGaming</key>
            <true/>
            <key>allowMusicService</key>
            <true/>
            <key>allowNews</key>
            <true/>
            <key>allowNFC</key>
            <true/>
            <key>allowNotificationsModification</key>
            <true/>
            <key>allowOpenFromManagedToUnmanaged</key>
            <false/>
            <key>allowOpenFromUnmanagedToManaged</key>
            <false/>
            <key>allowPassbookWhileLocked</key>
            <true/>
            <key>allowPhotoStream</key>
            <true/>
            <key>allowSafari</key>
            <true/>
            <key>allowScreenshot</key>
            <true/>
            <key>allowSharedStream</key>
            <true/>
            <key>allowSimpleRemoteLock</key>
            <true/>
            <key>allowSpotlightInternetResults</key>
            <true/>
            <key>allowSystemAppRemoval</key>
            <false/>
            <key>allowUIAppInstallation</key>
            <false/>
            <key>allowUIConfigurationProfileInstallation</key>
            <true/>
            <key>allowUntrustedTLSPrompt</key>
            <false/>
            <key>allowVideoConferencing</key>
            <true/>
            <key>allowVoiceDialing</key>
            <true/>
            <key>allowWallpaperModification</key>
            <true/>
            <key>allowYouTube</key>
            <true/>
            <key>enforcedRemoteLockTimeout</key>
            <integer>60</integer>
            <key>forceAssistantProfanityFilter</key>
            <true/>
        </dict>
        <!-- Wi-Fi payload: connect to AirPak Office Wi-Fi automatically -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.wifi.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.airpak.express.wifi.office</string>
            <key>PayloadUUID</key>
            <string>C3D4E5F6-A7B8-4C9D-0E1F-2A3B4C5D6E7F</string>
            <key>PayloadDisplayName</key>
            <string>AirPak Office Wi-Fi</string>
            <key>PayloadDescription</key>
            <string>Auto-connect to AirPak office network with enterprise security</string>
            <key>SSID_STR</key>
            <string>AirPak-Office</string>
            <key>AutoJoin</key>
            <true/>
            <key>EncryptionType</key>
            <string>WPA3</string>
            <key>IsHotspot</key>
            <false/>
            <key>ServiceSetIdentifier</key>
            <string>AirPak-Office</string>
            <key>Password</key>
            <string>REPLACE_WITH_OFFICE_PSK</string>
        </dict>
        <!-- Notifications payload: enable AirPak notifications with sound -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.notificationsettings</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.airpak.express.notifications.staff</string>
            <key>PayloadUUID</key>
            <string>D4E5F6A7-B8C9-4D0E-1F2A-3B4C5D6E7F8A</string>
            <key>PayloadDisplayName</key>
            <string>AirPak Notifications</string>
            <key>NotificationSettings</key>
            <array>
                <dict>
                    <key>BundleIdentifier</key>
                    <string>com.airpak.express.web</string>
                    <key>BundleName</key>
                    <string>AirPak Express</string>
                    <key>AllowCriticalAlerts</key>
                    <true/>
                    <key>AllowNotifications</key>
                    <true/>
                    <key>AllowSound</key>
                    <true/>
                    <key>ShowInLockScreen</key>
                    <true/>
                    <key>ShowInNotificationCenter</key>
                    <true/>
                    <key>AlertType</key>
                    <integer>1</integer>
                </dict>
            </array>
        </dict>
        <!-- Mail payload: AirPak support email account -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.mail.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.airpak.express.mail.support</string>
            <key>PayloadUUID</key>
            <string>E5F6A7B8-C9D0-4E1F-2A3B-4C5D6E7F8A9B</string>
            <key>PayloadDisplayName</key>
            <string>AirPak Support</string>
            <key>EmailAddress</key>
            <string>support@airpak-express.com</string>
            <key>PayloadDescription</key>
            <string>Pre-configured AirPak support mailbox</string>
            <key>PreventMove</key>
            <true/>
            <key>PreventDeletion</key>
            <true/>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>AirPak Express — Staff Profile</string>
    <key>PayloadDescription</key>
    <string>Configures device for AirPak Express staff: PWA install, Wi-Fi, restrictions, notifications, and support email.</string>
    <key>PayloadIdentifier</key>
    <string>com.airpak.express.staff.profile</string>
    <key>PayloadOrganization</key>
    <string>AirPak Express Pte Ltd</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>F6A7B8C9-D0E1-4F2A-3B4C-5D6E7F8A9B0C</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadScope</key>
    <string>System</string>
    <key>ConsentText</key>
    <dict>
        <key>default</key>
        <string>By installing this profile, you agree that AirPak Express may configure your device for work use, including Wi-Fi, notifications, and a pre-installed web app.</string>
    </dict>
</dict>
</plist>
